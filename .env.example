# Copie para .env e preencha. NUNCA comite o .env.
# Postgres — precisa da extensão btree_gist (usada na exclusion constraint da agenda)
DATABASE_URL=postgres://usuario:senha@localhost:5432/dent

# Fase 3 — autenticação
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Fase 9 — WhatsApp (Meta Cloud API oficial)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Fase 10 — armazenamento de anexos (S3/R2). Bucket privado, sempre URL assinada.
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
