# Copie para .env e preencha. NUNCA comite o .env.
#
# ── Postgres: DUAS credenciais, com papéis diferentes ────────────────────────
# Precisa da extensão btree_gist (usada na exclusion constraint da agenda).
#
# `DATABASE_URL` é a credencial do DONO do banco. Ela roda migration, seed,
# `db:verificar`, backup e restauração — e, por ser dona (e superusuário na imagem
# oficial), **ela ignora a Row Level Security**. Em produção isso é credencial de
# operação: não deve ficar no ambiente do serviço web.
DATABASE_URL=postgres://usuario:senha@localhost:5432/facilident

# ── Senha da role de aplicação (drizzle/0023) ───────────────────────────────
# `facilident_app` não é dona das tabelas e não tem BYPASSRLS — é justamente isso
# que faz a política de isolamento entre clínicas valer. Quem aplica esta senha é
# `./docker/credencial-app.sh`, que **se recusa a rodar em produção** com o valor
# de desenvolvimento ou com senha curta.
#
#   openssl rand -base64 36
#
# Em desenvolvimento pode ficar vazia (o script usa um padrão conhecido).
APP_DB_PASSWORD=

# Fase 3 — autenticação
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Cifra o segredo do segundo fator (TOTP) em repouso — `usuario.mfa_secret`.
#
#   openssl rand -base64 48
#
# Em desenvolvimento pode ficar vazia (o compose usa um padrão conhecido). Em
# produção o app **se recusa a subir** sem ela ou com o valor de desenvolvimento:
# com a chave pública, um dump do banco entrega o segundo fator de todos os
# usuários. Não é bypass — ainda exige a senha — é o agravamento que cifrar tira.
#
# ⚠️ TROCAR esta chave num sistema em operação tranca todos fora do segundo fator:
# os valores gravados não decifram com a chave nova. O formato tem versão (`v1$…`)
# justamente para a troca ser possível sem parada; ver lib/auth/mfaSegredo.ts.
# O caminho de emergência é reiniciar o MFA dos usuários (apaga o segredo, não o
# mostra) — e isso exige que cada um reconfigure o autenticador.
MFA_CHAVE=

# ── Fase 9 — WhatsApp (Meta Cloud API oficial) ───────────────────────────────
# 'simulado' (padrão) faz o fluxo inteiro funcionar sem conta na Meta: fila,
# webhook, confirmação na agenda. Só 'meta' envia de verdade — e não há queda
# automática de um para o outro, nos dois sentidos, de propósito.
WHATSAPP_PROVEDOR=simulado

# Necessários apenas com WHATSAPP_PROVEDOR=meta.
# O Phone Number ID é do número remetente no painel da Meta, não o telefone.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=

# App Secret da aplicação na Meta. É o que assina o webhook (HMAC SHA-256).
# Sem ele o webhook RECUSA tudo — e é o certo: quem consegue postar no webhook
# consegue cancelar consulta de qualquer paciente.
WHATSAPP_APP_SECRET=

# Token combinado no handshake de verificação do webhook (você escolhe o valor).
WHATSAPP_VERIFY_TOKEN=

# ── Fase 10 — anexos do prontuário ───────────────────────────────────────────
# 'disco' (padrão) grava em ARMAZENAMENTO_RAIZ; 's3' usa bucket privado.
# Não há queda automática de um para o outro: metade da configuração significa
# radiografia gravada no lugar errado.
ARMAZENAMENTO=disco

# Obrigatória em produção com 'disco': sem ela os anexos iriam para dentro do
# container e desapareceriam no deploy. Precisa de backup.
ARMAZENAMENTO_RAIZ=/anexos

# Necessários apenas com ARMAZENAMENTO=s3. Host do bucket, sem esquema —
# ex.: facilident.abc123.r2.cloudflarestorage.com. Região é 'auto' no R2.
S3_HOST=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# ── Verificação em duas etapas ───────────────────────────────────────────────
# `true` desliga o segundo fator do staff: o login ignora o campo do código.
# Vale SÓ em desenvolvimento — com esta chave ligada e NODE_ENV=production o app
# se recusa a subir, de propósito. MFA é exigência de prontuário: sem ele, uma
# senha vazada abre o histórico clínico de todos os pacientes.
MFA_DESABILITADO=false
