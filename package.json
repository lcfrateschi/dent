{
  "name": "dent",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de gestão para consultório odontológico",
  "scripts": {
    "dev": "next dev",
    "build": "NODE_ENV=production next build",
    "start": "next start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx lib/db/seed/index.ts",
    "whatsapp:despachar": "tsx lib/mensageria/executar-despacho.ts",
    "whatsapp:demo": "tsx lib/mensageria/demonstrar.ts",
    "documentos:demo": "tsx lib/documentos/demonstrar.ts",
    "relatorios:demo": "tsx lib/relatorios/demonstrar.ts",
    "portal:seguranca": "tsx lib/portal/revisao-seguranca.ts",
    "tuss:importar": "tsx lib/tiss/importarTuss.ts",
    "convenio:demo": "tsx lib/tiss/demonstrar.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:verificar": "docker compose exec -T db psql -U ${POSTGRES_USER:-dent} -d ${POSTGRES_DB:-dent} -q -f - < docker/verificar-invariantes.sql",
    "docker:up": "docker compose up",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v && docker compose up",
    "docker:logs": "docker compose logs -f app"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.27.0",
    "next": "^15.5.22",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
